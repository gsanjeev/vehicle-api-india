#%RAML 1.0
title: vehicle-api-india
version: v1
baseUri: https://vehicle-api-india.example.com/{version}
mediaType: application/json

types:
  NotifyRequest:
    type: object
    properties:
      type:
        type: string
        required: true
        description: The notification type
      prjId:
        type: string
        required: true
        description: The project identifier
      orderNum:
        type: string
        required: true
        description: The order number
      validTill:
        type: date-only
        required: true
        description: Validity date for the notification (YYYY-MM-DD)

  OrderDetail:
    type: object
    properties:
      orderNum:
        type: string
        description: The order number
      type:
        type: string
        description: The order type
      prjId:
        type: string
        description: The project identifier
      validTill:
        type: date-only
        description: Validity date (YYYY-MM-DD)
      status:
        type: string
        description: Current status of the order
      vehicleDetails:
        type: object
        description: Vehicle information associated with the order
        properties:
          make:
            type: string
            description: Vehicle manufacturer
          model:
            type: string
            description: Vehicle model
          year:
            type: integer
            description: Manufacturing year
          vin:
            type: string
            description: Vehicle Identification Number
      createdAt:
        type: datetime
        description: Order creation timestamp
      updatedAt:
        type: datetime
        description: Order last updated timestamp

/mcd:
  /notify:
    post:
      displayName: Send MCD Notification
      description: Submit a notification with vehicle order details. Returns 204 on success with no response body.
      body:
        application/json:
          type: NotifyRequest
          example:
            type: "VEHICLE_ORDER"
            prjId: "PRJ-001"
            orderNum: "ORD-2026-00123"
            validTill: "2026-12-31"
      responses:
        204:
          description: Notification received successfully. No content returned.
        400:
          description: Bad Request - Invalid or missing required fields.
          body:
            application/json:
              type: object
              properties:
                code:
                  type: string
                message:
                  type: string
              example:
                code: "INVALID_REQUEST"
                message: "Missing required field: orderNum"
        500:
          description: Internal Server Error.
          body:
            application/json:
              type: object
              properties:
                code:
                  type: string
                message:
                  type: string

/kdpn:
  /nmon:
    post:
      displayName: Get Order Details
      description: Retrieve order details by providing an order number. Returns the full order detail object.
      body:
        application/json:
          type: object
          properties:
            orderNum:
              type: string
              required: true
              description: The order number to retrieve details for
          example:
            orderNum: "ORD-2026-00123"
      responses:
        200:
          description: Order details retrieved successfully.
          body:
            application/json:
              type: OrderDetail
              example:
                orderNum: "ORD-2026-00123"
                type: "VEHICLE_ORDER"
                prjId: "PRJ-001"
                validTill: "2026-12-31"
                status: "ACTIVE"
                vehicleDetails:
                  make: "Toyota"
                  model: "Camry"
                  year: 2026
                  vin: "1HGBH41JXMN109186"
                createdAt: "2026-01-15T10:30:00Z"
                updatedAt: "2026-10-25T08:00:00Z"
        400:
          description: Bad Request - Order number is missing or invalid.
          body:
            application/json:
              type: object
              properties:
                code:
                  type: string
                message:
                  type: string
              example:
                code: "INVALID_REQUEST"
                message: "orderNum is required"
        404:
          description: Order not found.
          body:
            application/json:
              type: object
              properties:
                code:
                  type: string
                message:
                  type: string
              example:
                code: "ORDER_NOT_FOUND"
                message: "No order found with orderNum: ORD-2026-00123"
        500:
          description: Internal Server Error.
          body:
            application/json:
              type: object
              properties:
                code:
                  type: string
                message:
                  type: string